# === Database ===
# Sesuai docker-compose.yml (Postgres dipetakan ke port 5433 di host)
DATABASE_URL="postgresql://cesia:cesia@localhost:5433/cesia?schema=public"
DIRECT_URL="postgresql://cesia:cesia@localhost:5433/cesia?schema=public"

# === Server ===
PORT=3000
NODE_ENV=development

# === Frontend (dipakai untuk CORS & CSP, harus sama persis dengan origin FE) ===
FRONTEND_URL="http://localhost:3001"

# === Auth ===
JWT_SECRET="ganti-dengan-string-acak-panjang"
JWT_EXPIRES_IN="15m"

# === Redis (BullMQ + cache) ===
REDIS_URL="redis://localhost:6379"

# === Sync OCA ===
# Kosongkan CRON_SYNC_DAILY_OCA untuk pakai default (tiap 30 menit).
CRON_SYNC_DAILY_OCA=
# Set "false" untuk mematikan sync otomatis saat development.
OCA_SYNC_ENABLED=false
CRON_SYNC_DAILY_CSAT=

# === Kredensial API Telkom OCA ===
# Kalau dikosongkan, aplikasi memakai fallback hardcoded di source dan
# menampilkan warning saat startup.
OCA_API_USERNAME=
OCA_API_PASSWORD=
